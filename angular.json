{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "public": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/public", "browser": "src/main.ts", "server": "src/main.server.ts",
            "outputMode": "static",
            "tsConfig": "tsconfig.app.json", "index": "src/index.html",
            "styles": ["src/styles.scss", "src/motion.scss"], "assets": [{ "glob": "**/*", "input": ".local/site-assets" }],
            "budgets": [{ "type": "initial", "maximumWarning": "550kB", "maximumError": "750kB" }]
          },
          "configurations": {
            "production": { "outputHashing": "all" },
            "development": { "optimization": false, "sourceMap": true }
          }, "defaultConfiguration": "production"
        },
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "public:build:development" } }
      }
    }
  }
}
